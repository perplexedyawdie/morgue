{
    "require": {
        "php": ">=8.4.27 <8.5",
        "slim/slim": "2.6.3",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "autoload": {
        "files": [
            "phplib/compat/slim2_php8.php"
        ]
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "../morgue_features/composer.json",
                "features/upload/composer.json"
            ]
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "config": {
        "platform": {
            "php": "8.4.27"
        },
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": true
        }
    }
}
